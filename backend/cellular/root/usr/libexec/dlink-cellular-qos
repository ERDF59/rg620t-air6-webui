#!/bin/sh

include_contexts="${2:-0}"
case "$1" in
	"5G SA") mode=C5GQOSRDP; label=5QI;;
	LTE|"5G NSA") mode=CGEQOSRDP; label=QCI;;
	*) [ "$include_contexts" = 1 ] || { echo '{"ok":false,"error":"unavailable"}'; exit 0; }
	   mode=; label=;;
esac
exec 9>/var/lock/dlink-cellular.lock || exit 1
flock -w 1 9 || { echo '{"ok":false,"error":"busy"}'; exit 0; }

parser=/usr/libexec/dlink-cellular-qos.awk
at() { timeout 2 /usr/bin/mipc_wan_cli --at_cmd "$1" 2>/dev/null; }
raw="$(at AT+CGCONTRDP)"
if [ "$include_contexts" = 1 ] && ! printf '%s\n' "$raw" | tr -d '\r' | grep -qx OK; then
	echo '{"ok":false,"error":"context_read"}'
	exit 0
fi
sessions="$(printf '%s\n' "$raw" | awk -v mode=contexts -v raw="$include_contexts" -f "$parser")"
printf '{"ok":true,"kind":"%s","sessions":[' "$label"
comma=
for session in $sessions; do
	cid=${session%%:*}
	apn=${session#*:}
	values=
	[ -z "$mode" ] || values="$(at "AT+$mode=$cid" | awk -v "id=$cid" -v "verb=$mode" -v mode=classes -f "$parser")"
	[ "$include_contexts" = 1 ] || [ -n "$values" ] || continue
	case "$apn" in [iI][mM][sS]|[iI][mM][sS].*) role=ims;; *) role=data;; esac
	printf '%s{"cid":%s,"apn":"%s","role":"%s","classes":[%s]}' "$comma" "$cid" "$apn" "$role" "$values"
	comma=,
done
printf ']}\n'
