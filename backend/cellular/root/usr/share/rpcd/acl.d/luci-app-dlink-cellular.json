      "ubus": {
        "dlink-cellular": [
          "sms_list",
          "sms_read",
          "diag",
          "diag_checks",
          "capture_status"
        ]
      }
    },
    "write": {
      "ubus": {
        "dlink-cellular": [
          "band_set",
          "cell_set",
          "cell_clear",
          "cell_list_set",
          "cell_list_clear",
          "sms_send",
          "capture_start",
          "capture_stop",
          "wan_redial"
        ]
      }
    }
  },
  "luci-app-dlink-cellular-voice": {
